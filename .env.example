# DATABASE (PostgreSQL / Supabase compatible)
DATABASE_URL="postgresql://user:password@localhost:5432/janic_character_report?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/janic_character_report?schema=public"

# NEXTAUTH
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-random-string-yang-aman"

# SESSION
SESSION_MAX_AGE_HOURS=12

# SUPABASE STORAGE (upload foto siswa, guru, logo, TTD, stempel)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# CLOUDINARY (opsional, alternatif storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# APP
NEXT_PUBLIC_APP_NAME="JANIC CHARACTER REPORT"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
